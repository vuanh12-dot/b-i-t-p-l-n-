import numpy as np

def rk4(f, a, b, y0, n) -> tuple[np.ndarray, np.ndarray]:
    """
    Phương pháp Runge-Kutta bậc 4 giải phương trình vi phân y' = f(x, y).
    """

    # Kiểm tra điều kiện áp dụng
    if a >= b:
        raise ValueError("Khoảng tính không hợp lệ: a phải nhỏ hơn b.")

    if not isinstance(n, (int, np.integer)) or isinstance(n, (bool, np.bool_)) or n <= 0:
        raise ValueError("Số bước chia n phải là số nguyên dương.")

    # [Dòng 16] - Thuật toán 18 (Bước 1): Tính độ dài bước nhảy h
    h = (b - a) / n
    
    # [Dòng 17-18] - Thuật toán 18 (Bước 1): Khởi tạo mảng x, y chứa điều kiện ban đầu (a, y0)
    x = [a]
    y = [y0]
    
    # Khởi tạo các danh sách K1, K2, K3, K4 tại điểm xuất phát (a, y0)
    K1 = [h * f(a, y0)]
    K2 = [h * f(a + h/2, y0 + K1[-1]/2)]
    K3 = [h * f(a + h/2, y0 + K2[-1]/2)]
    K4 = [h * f(a + h, y0 + K3[-1])]

    # [Dòng 29] - Thuật toán 18 (Bước 2): Vòng lặp tính toán n bước
    for i in range(n):
        # [Dòng 30] - Thuật toán 18 (Bước 4): Tính điểm lưới x tiếp theo x_{i+1} = x_i + h
        x.append(x[-1] + h)
        
        # [Dòng 31] - Thuật toán 18 (Bước 4): Tính y_{i+1} theo công thức cập nhật trọng số RK4
        y.append(y[-1] + 1/6 * (K1[-1] + 2*K2[-1] + 2*K3[-1] + K4[-1]))
        
        # [Dòng 32-35] - Thuật toán 18 (Bước 3): Tính 4 hệ số dốc K1, K2, K3, K4 cho điểm lưới mới
        K1.append(h * f(x[-1], y[-1]))
        K2.append(h * f(x[-1] + h/2, y[-1] + K1[-1]/2))
        K3.append(h * f(x[-1] + h/2, y[-1] + K2[-1]/2))
        K4.append(h * f(x[-1] + h, y[-1] + K3[-1]))

    # [Dòng 37] - Thuật toán 18 (Bước 6): Trả về dữ liệu dạng numpy array
    return np.array(x), np.array(y)
